# ==============================================================================
# ReleaseGate FastAPI Control Plane Environment Configuration Template
# All secrets and credentials must be provided via environment variables.
# ==============================================================================

# Application Environment Mode: development | staging | production | testing
ENVIRONMENT=development
APP_NAME=ReleaseGate Control Plane API
APP_VERSION=0.1.0
DEBUG=false

# Networking
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Security & CORS
# In production, provide comma-separated authorized origins (e.g., https://app.releasegate.internal)
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=change-this-to-a-secure-random-secret-in-production

# PostgreSQL Database Configuration (SQLAlchemy 2.0)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/releasegate_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_ECHO=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=text
REDACT_SENSITIVE_LOGS=true

# Health & Readiness Timeouts (seconds)
DB_READINESS_TIMEOUT_SECONDS=3.0
